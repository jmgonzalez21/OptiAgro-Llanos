{
  "name": "optiagro-llanos-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SPA de OptiAgro-Llanos (Vue 3 + Vite + TypeScript)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
