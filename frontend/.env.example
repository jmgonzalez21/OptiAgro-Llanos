# Copia este archivo a .env (ignorado por git) para cambiar la configuración local.

# true  -> usa la capa mock (sin backend).
# false -> API real de Django en VITE_API_BASE (valor por defecto).
VITE_USE_MOCK=false

# Base de la API REST (por defecto /api/v1, resuelta por el proxy de Vite en desarrollo).
VITE_API_BASE=/api/v1

# Destino del proxy de desarrollo para /api (solo en `npm run dev`).
VITE_PROXY_TARGET=http://127.0.0.1:8000
