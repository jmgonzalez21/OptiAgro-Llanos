# Copie este archivo a .env (ignorado por git) y cambie TODOS los valores de ejemplo.
# Nunca suba .env ni contraseñas reales al repositorio.

# --- Puertos publicados ---
# Única entrada de la aplicación (SPA + API por /api/): http://localhost:8080
FRONTEND_PORT=8080
# Acceso directo al backend solo en loopback, para desarrollo (npm run dev). Opcional.
# BACKEND_PORT=8000

# --- Django ---
DJANGO_SECRET_KEY=cambie-esta-clave-por-una-larga-y-aleatoria
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8080,http://127.0.0.1:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# El admin de Django NO forma parte de la app presentada. false (por defecto) = /admin/ responde 404.
OPTIAGRO_ADMIN_HABILITADO=false

# --- PostgreSQL 16 ---
POSTGRES_DB=optiagro
POSTGRES_USER=optiagro
POSTGRES_PASSWORD=cambie-esta-contrasena

# --- JWT (minutos). El refresh rota en cada renovación (ventana deslizante) y se revoca al cerrar sesión ---
JWT_ACCESS_MINUTOS=30
JWT_REFRESH_MINUTOS=1440

# --- Gunicorn ---
# GUNICORN_WORKERS=2
# GUNICORN_TIMEOUT=120

# --- Datos y usuarios de demostración (FICTICIOS) ---
# true: al arrancar crea los usuarios demo y los datos FICTICIOS SOLO si no existen (idempotente).
OPTIAGRO_CARGAR_DEMO=false
DEMO_ADMIN_USERNAME=admin_demo
DEMO_ADMIN_PASSWORD=cambie-contrasena-admin-demo
DEMO_ANALISTA_USERNAME=analista_demo
DEMO_ANALISTA_PASSWORD=cambie-contrasena-analista-demo

# --- Distancias por carretera (OSRM sobre OpenStreetMap) ---
# La ruta es la que calcula OSRM (en general la más corta/rápida por carretera; NO se restringe a vías nacionales).
# El servidor público es de uso razonable y sin garantías; para producción conviene alojar OSRM propio.
# Si OSRM falla, las distancias se estiman (línea recta x 1,3) y se marcan "estimada".
OPTIAGRO_OSRM_HABILITADO=true
OPTIAGRO_OSRM_URL=https://router.project-osrm.org
OPTIAGRO_OSRM_TIMEOUT=10

# --- Límites de tamaño de los problemas (opcionales; los valores mostrados son los de por defecto) ---
# OPTIAGRO_MAX_EMPRESAS=200
# OPTIAGRO_MAX_PLANTAS=50
# OPTIAGRO_MAX_RUTAS=2000
# OPTIAGRO_AG_MAX_POBLACION=300
# OPTIAGRO_AG_MAX_GENERACIONES=1000
# poblacion x generaciones x rutas x corridas (~0.4 microsegundos por unidad: 20M ~ 8 s)
# OPTIAGRO_AG_MAX_TRABAJO=20000000
# OPTIAGRO_SENSIBILIDAD_MAX_ESCENARIOS=40
# OPTIAGRO_ESCALABILIDAD_MAX_TAMANOS=8
# OPTIAGRO_ESCALABILIDAD_MAX_TRABAJO=60000000
